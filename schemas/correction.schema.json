{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "correction.schema.json",
  "title": "Correction",
  "description": "PROPOSED contract for Correction Layer. Design stage only; no implementation produces or consumes this yet. A person's correction, kept verbatim, with what it was about and what became of it.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema, used by tools/check_repo.py."
    },
    "_note": {
      "type": "string",
      "description": "Marks an example file as proposed/illustrative."
    },
    "schema_version": {
      "const": "cl.correction/1"
    },
    "correction_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "anyOf": [
        {
          "type": "string",
          "description": "The person's own words, unchanged. Null when the correction was extracted from an edit, not from words."
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "channel": {
      "enum": [
        "app",
        "assistant",
        "observed_chat",
        "observed_edit",
        "review_action"
      ],
      "description": "Where it came from. app: typed into the app. assistant: relayed by an assistant (unattested). observed_chat: a user turn attested by a runtime event adapter. observed_edit: extracted from a human edit. review_action: a rejection or dispute reason."
    },
    "signal_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "ai_model_used": {
          "type": "boolean"
        },
        "parameters_grounded": {
          "type": "boolean"
        },
        "referent_resolved": {
          "type": "boolean"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "ai_model_used",
        "parameters_grounded",
        "referent_resolved"
      ]
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "display_tz": {
      "type": "string"
    },
    "about": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "artifact_name": {
              "type": "string"
            },
            "content_hash": {
              "$ref": "common.schema.json#/$defs/hash"
            },
            "location": {
              "$ref": "common.schema.json#/$defs/location"
            }
          },
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "content_hash"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution": {
      "enum": [
        "rule",
        "guidance",
        "upstream_fix",
        "pending",
        "dismissed"
      ]
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    }
  },
  "required": [
    "schema_version",
    "correction_id",
    "workspace_id",
    "text",
    "author",
    "channel",
    "recorded_at",
    "resolution",
    "rule_ids"
  ],
  "additionalProperties": false
}
