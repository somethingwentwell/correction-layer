{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact.schema.json",
  "title": "Normalized artifact",
  "description": "PROPOSED contract for Correction Layer. Design stage only; no implementation produces or consumes this yet. The typed, format-neutral form of one artifact version, with provenance and a coverage report.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema, used by tools/check_repo.py."
    },
    "_note": {
      "type": "string",
      "description": "Marks an example file as proposed/illustrative."
    },
    "schema_version": {
      "const": "cl.artifact/1"
    },
    "artifact_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer"
        },
        "content_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "size_bytes": {
          "type": "integer"
        },
        "observed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "seq",
        "content_hash",
        "observed_at"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "declared_extension": {
          "type": "string"
        },
        "detected_type": {
          "type": "string"
        },
        "detection": {
          "enum": [
            "signature",
            "container_inspection",
            "structural"
          ]
        },
        "extension_matches": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "declared_extension",
        "detected_type",
        "detection",
        "extension_matches"
      ]
    },
    "artifact_type": {
      "enum": [
        "document",
        "spreadsheet",
        "pdf",
        "presentation",
        "record",
        "email",
        "text"
      ]
    },
    "parser": {
      "$ref": "common.schema.json#/$defs/parser"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "state": {
            "enum": [
              "parsed",
              "partial",
              "detected_not_parsed",
              "unsupported",
              "absent"
            ]
          },
          "content_bearing": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "component",
          "state",
          "content_bearing"
        ]
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "locator": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "cell": {
                "type": "object",
                "properties": {
                  "formula": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "value": {
                    "$ref": "common.schema.json#/$defs/typed_value"
                  },
                  "display_text": {
                    "type": "string"
                  },
                  "value_state": {
                    "enum": [
                      "literal",
                      "formula_cached",
                      "formula_no_cache",
                      "formula_error",
                      "external_link_cached"
                    ]
                  },
                  "hidden": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "value_state"
                ],
                "description": "Spreadsheet cells only: formula, stored value, displayed text and how the value was obtained."
              },
              "ocr_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Scanned pages only: lowest token confidence in this block."
              }
            },
            "additionalProperties": false,
            "required": [
              "locator",
              "kind"
            ]
          }
        },
        "abridged": {
          "type": "boolean",
          "description": "True when an example omits most blocks."
        }
      },
      "additionalProperties": false,
      "required": [
        "blocks"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "value": {
            "$ref": "common.schema.json#/$defs/typed_value"
          },
          "method": {
            "enum": [
              "structural",
              "mapping",
              "pattern",
              "ocr",
              "model_suggested",
              "human_confirmed"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mapping_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/location"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "method",
          "confidence",
          "locations"
        ]
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flag": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/location"
            }
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "flag"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "version",
    "identity",
    "artifact_type",
    "parser",
    "coverage",
    "content",
    "fields",
    "risk_flags"
  ],
  "additionalProperties": false
}
