{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule.schema.json",
  "title": "Rule revision",
  "description": "PROPOSED contract for Correction Layer. Design stage only; no implementation produces or consumes this yet. One revision of a rule as shown to clients: the immutable revision content, plus lifecycle fields (status, approval, cases[].last_result) projected from ledger events. Words (title, statement, message) are rendered from the typed fields by templates.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema, used by tools/check_repo.py."
    },
    "_note": {
      "type": "string",
      "description": "Marks an example file as proposed/illustrative."
    },
    "schema_version": {
      "const": "cl.rule/1"
    },
    "rule_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "$ref": "common.schema.json#/$defs/rule_status"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "origin": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "human_correction",
            "starter_pack",
            "imported_pack"
          ]
        },
        "correction_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "pack": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "review_by": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "scope": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "workspace",
            "project_group",
            "project",
            "area",
            "artifact"
          ]
        },
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "project_selector": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "fact": {
                  "type": "string"
                },
                "equals": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "fact",
                "equals"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "area_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "work_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Empty list means any"
        },
        "artifact_types": {
          "type": "array",
          "items": {
            "enum": [
              "document",
              "spreadsheet",
              "pdf",
              "presentation",
              "record",
              "email",
              "text"
            ]
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Empty list means any"
        }
      },
      "additionalProperties": false,
      "required": [
        "level",
        "workspace_id",
        "work_types",
        "artifact_types",
        "actions"
      ]
    },
    "applies_when": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/predicate"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "$ref": "common.schema.json#/$defs/method"
    },
    "enforcement": {
      "$ref": "common.schema.json#/$defs/enforcement"
    },
    "locked": {
      "type": "boolean",
      "description": "Only the owner or a workspace steward may pause it or grant exceptions."
    },
    "check": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "field_present",
            "field_in_set",
            "fields_agree",
            "number_compare",
            "date_window",
            "arithmetic_consistency",
            "section_present",
            "text_contains",
            "no_unresolved_markup",
            "field_matches_source",
            "attestation",
            "no_hidden_content",
            "rows_unique",
            "value_is_formula",
            "model_review"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "targets",
        "params"
      ]
    },
    "requires": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "fields",
        "components"
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "max_age_days": {
              "type": "integer"
            },
            "require_latest": {
              "type": "boolean"
            },
            "missing_key": {
              "enum": [
                "unknown",
                "fail"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "source_id",
            "max_age_days",
            "require_latest",
            "missing_key"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "string"
        },
        "fix_hint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "problem"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "enum": [
              "negative",
              "positive"
            ]
          },
          "description": {
            "type": "string"
          },
          "artifact_hash": {
            "$ref": "common.schema.json#/$defs/hash"
          },
          "source_snapshot_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "expect": {
            "$ref": "common.schema.json#/$defs/outcome"
          },
          "last_result": {
            "$ref": "common.schema.json#/$defs/outcome"
          },
          "last_run_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        },
        "additionalProperties": false,
        "required": [
          "case_id",
          "kind",
          "description",
          "artifact_hash",
          "expect"
        ]
      }
    },
    "exception_policy": {
      "type": "object",
      "properties": {
        "grantable_by": {
          "type": "array",
          "items": {
            "enum": [
              "rule_owner",
              "workspace_steward",
              "project_steward"
            ]
          }
        },
        "max_days": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "grantable_by",
        "max_days"
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "proposed_by": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "approved_by": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "approved_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "activated_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "self_approval": {
              "type": "boolean"
            },
            "policy_rev": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "approved_by",
            "approved_at"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "rule_id",
    "revision",
    "status",
    "title",
    "statement",
    "origin",
    "owner",
    "review_by",
    "scope",
    "method",
    "enforcement",
    "check",
    "requires",
    "message",
    "cases"
  ],
  "additionalProperties": false
}
