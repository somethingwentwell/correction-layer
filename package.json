{
  "name": "correction-layer",
  "version": "0.1.0",
  "private": true,
  "description": "Correction Layer - Phase 1 local-first MVP framework scaffold (not the finished product)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check:design": "python3 tools/check_repo.py",
    "verify": "npm run typecheck && npm run build && npm test && npm run check:design",
    "migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "seed:demo": "node --env-file-if-exists=.env src/cli.ts seed-demo",
    "dev": "node --env-file-if-exists=.env --watch src/cli.ts serve",
    "start": "node --env-file-if-exists=.env dist/src/cli.js serve",
    "cli": "node --env-file-if-exists=.env src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
