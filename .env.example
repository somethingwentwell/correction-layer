# Correction Layer - local configuration (copy to .env; .env is gitignored).
# No secrets are needed to run the Phase 1 scaffold. Never put credentials here:
# the signing key is generated into CL_DATA_DIR on first start, outside the repo.

# Where the workspace store (SQLite + signing key) lives. Default: the per-user
# data directory ($XDG_DATA_HOME/correction-layer or ~/.local/share/correction-layer).
# The design forbids keeping the live store inside a project folder (ADR-001);
# ./.data is gitignored and acceptable for development only.
# CL_DATA_DIR=./.data

# Loopback only. Binding to a non-loopback host is refused.
CL_HOST=127.0.0.1
CL_PORT=4319

# IANA timezone used for display. Stored times are always UTC.
CL_DISPLAY_TZ=Asia/Singapore

# Solo mode: the single local person who uses the app surface (name only, no credential).
CL_LOCAL_USER_NAME=Local user

# When "1", `serve` loads the labelled DEMO workspace data into an empty store.
CL_SEED_DEMO=0
